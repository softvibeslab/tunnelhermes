[Unit]
Description=Hermes Cursor Replica Bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
# Sustituir estos valores y revisar rutas con la cuenta real; NO ejecutar como root.
User=REPLACE_SERVICE_USER
Group=REPLACE_SERVICE_GROUP
WorkingDirectory=/REPLACE/kit
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/REPLACE/state/scratch
ExecStart=/usr/bin/python3 /REPLACE/kit/bridge.py --config /REPLACE/state/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Ajustar a los directorios del perfil, sesiones y scratch. Repositorios montados read-only.
ReadWritePaths=/REPLACE/state /REPLACE/hermes-home
ReadOnlyPaths=/REPLACE/repos
KillMode=control-group
TimeoutStopSec=15
[Install]
WantedBy=multi-user.target
